<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>RingDraft</AssemblyName>
    <RootNamespace>RingDraft</RootNamespace>

    <!-- Your Steam install. Override without editing: dotnet build -p:Sts2Dir="D:\SteamLibrary\steamapps\common\Slay the Spire 2" -->
    <Sts2Dir Condition="'$(Sts2Dir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2</Sts2Dir>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckGameFound" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Sts2DataDir)\sts2.dll')"
           Text="sts2.dll not found in $(Sts2DataDir). Pass -p:Sts2Dir=&quot;path\to\Slay the Spire 2&quot;." />
  </Target>

  <!-- Copies RingDraft.dll + RingDraft.json into <game>\mods\RingDraft\ after every build. -->
  <Target Name="CopyToMods" AfterTargets="Build" Condition="Exists('$(Sts2Dir)')">
    <MakeDir Directories="$(Sts2Dir)\mods\RingDraft" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)\RingDraft.json" DestinationFolder="$(Sts2Dir)\mods\RingDraft" />
    <Message Importance="high" Text="Ring Draft copied to $(Sts2Dir)\mods\RingDraft" />
  </Target>

  <!-- Keeps the Steam Workshop upload folder current. -->
  <Target Name="CopyToWorkshop" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)\workshop\content" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)\RingDraft.json" DestinationFolder="$(MSBuildProjectDirectory)\workshop\content" />
  </Target>
</Project>
